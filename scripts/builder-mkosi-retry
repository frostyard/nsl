#!/usr/bin/env python3
"""Run a mkosi command and retry it when only a metadata sync or a package download failed.

Usage: builder-mkosi-retry COMMAND [ARGS...]

Distribution mirrors can lag the repository index, so a package-manager metadata sync
or a package download can fail with a transient error. mkosi runs the failed step
again from the start of a new run, so a retry is safe. Every other failure, a missing
package for example, ends the build at once.

A run is retried only when its last mkosi log messages are exactly one step, the
failure of that step's command, and at most one sandbox-command line, and when the
step and command show one of these failures:

- metadata sync: the step is "Syncing package manager metadata" and the command is a
  sync command (dnf or dnf5 makecache, apt-get update, pacman --sync --refresh, zypper
  refresh), whatever the output between the two lines.
- package download: the step installs packages (Installing Debian, Installing extra
  packages for X, Downloading Arch Linux keyring, and the like) and the command
  installs packages with dnf, dnf5, apt-get, pacman or zypper, and the plain output
  between the step and the failure line shows a download failure of that tool: a
  failed fetch of a package file, with no sign of a missing package.

A download counts only when a mirror caused it. dnf and dnf5 need a mirror or curl line
that names an http or https URL, zypper needs libzypp's network-error text, and apt-get
and pacman need a network reason on each failed fetch line; a line that names a local
failure such as "No space left on device", "Permission denied", "filesystem error",
"Input/output error" or "Failure writing output to destination" means no retry.

A Python traceback anywhere in the output means no retry.
NSL_MKOSI_TRIES (default 3) and NSL_MKOSI_RETRY_DELAY (default 60 s) tune the tries
and the backoff base for tests; the delay before try n+1 is base * 3^(n-1).
"""
import os
import re
import shlex
import subprocess
import sys
import time

ANSI = re.compile(r'\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])')
SYNC_STEP = 'Syncing package manager metadata'
INSTALL_STEP = re.compile(r'^(?:Installing [^…]+|Downloading [^…]+ keyring)$')
NOT_INSTALL_STEP = 'Installing cache copies'
PREBUILT_UKI_STEP = 'Installing prebuilt UKI at '
SANDBOX_LINE = ('(sandbox command omitted', 'Sandbox command:')
IMAGE_PREFIX = re.compile(r'^\[[^\]]*\] ?')
FAILED = re.compile(r'^"(.*)" returned non-zero exit code \d+\.$')
TRACEBACK = 'Traceback (most recent call last):'
MESSAGES = {'sync': 'Package metadata sync failed', 'download': 'Package download failed'}
PACMAN_COMMIT = 'error: failed to commit transaction (failed to retrieve some files)'
# A local failure is never a mirror failure, whatever the tool's download summary says.
LOCAL_FAILURES = ('No space left on device', 'Disk quota exceeded', 'Read-only file system',
                  'Permission denied', 'Input/output error', 'filesystem error',
                  'Cannot allocate memory', 'Too many open files',
                  'Failure writing output to destination', 'Failed writing',
                  'Error writing to file', 'File too large')
DNF_MISSING = ('No match for argument', 'Unable to find a match', 'Failed to resolve the transaction')
DNF_NETWORK = ('Curl error (', 'Status code: ')
ZYPPER_NETWORK = ("Download (curl) error for '", "Timeout exceeded when accessing '",
                  'is temporarily unaccessible', "not found on medium 'http")
# apt prints an HTTP status, or one of its methods/ strings, when a mirror is at fault.
APT_STATUS = re.compile(r'\s[1-5]\d\d\s')
APT_NETWORK = ('Could not connect to ', "Could not resolve '", "Temporary failure resolving '",
               "Something wicked happened resolving '", 'Unable to connect to ',
               'Connection failed', 'Connection timed out', 'Error reading from server',
               'Hash Sum mismatch', 'File has unexpected size')
# pacman repeats curl's reason after " : "; its own text does not name a network cause.
PACMAN_NETWORK = ('The requested URL returned error: ', 'Could not resolve host',
                  'Resolving timed out', 'Failed to connect', "Couldn't connect to server",
                  'Connection timed out', 'Operation timed out', 'Operation too slow',
                  'Connection reset', 'Recv failure', 'Send failure', 'SSL connect error',
                  'transfer closed', 'Empty reply from server', 'HTTP/2 stream',
                  'expected download size exceeded')


def cleaned(line):
    """Return a log line without ANSI escapes and surrounding whitespace."""
    return ANSI.sub('', line).strip()


def message(line):
    """Return the text of a mkosi log line, or None when the line is not one."""
    line = cleaned(line)
    if not line.startswith('‣'):
        return None
    text = line[1:].strip()
    return IMAGE_PREFIX.sub('', text).strip()


def split_command(quoted):
    """Return the words of the quoted command of a failure line."""
    try:
        return shlex.split(quoted)
    except ValueError:
        return []


def is_sync_command(quoted):
    """True when the quoted command of a failure line is a package-manager metadata sync."""
    words = split_command(quoted)
    if not words:
        return False
    tool, arguments = os.path.basename(words[0]), words[1:]
    if tool in ('dnf', 'dnf5'):
        return 'makecache' in arguments
    if tool == 'apt-get':
        return 'update' in arguments
    if tool == 'pacman':
        return '--sync' in arguments and '--refresh' in arguments
    if tool == 'zypper':
        return 'refresh' in arguments
    return False


def install_tool(quoted):
    """Return the package manager whose install command failed, or None."""
    words = split_command(quoted)
    if not words:
        return None
    tool, arguments = os.path.basename(words[0]), words[1:]
    if tool in ('dnf', 'dnf5'):
        return 'dnf' if 'install' in arguments else None
    if tool == 'apt-get' or tool == 'zypper':
        return tool if 'install' in arguments else None
    if tool == 'pacman':
        # The keyring step adds --downloadonly; a refresh is a sync, not an install.
        return tool if '--sync' in arguments and '--refresh' not in arguments else None
    return None


def is_install_step(step):
    """True when a mkosi step installs packages, so a download failure there is transient."""
    if step == NOT_INSTALL_STEP or step.startswith(PREBUILT_UKI_STEP):
        return False
    return INSTALL_STEP.match(step) is not None


def apt_download_failure(lines):
    """True when apt-get failed to fetch package files from a mirror, naming no missing package."""
    def failed(line):
        return (line.startswith('E: Failed to fetch ')
                or line.startswith('E: Unable to fetch some archives'))

    errors = [line for line in lines if line.startswith('E: ')]
    fetches = [line for line in errors if line.startswith('E: Failed to fetch ')]
    if not fetches or not all(failed(line) for line in errors):
        return False
    return all(APT_STATUS.search(line) or any(marker in line for marker in APT_NETWORK)
               for line in fetches)


def dnf_download_failure(lines):
    """True when dnf or dnf5 failed to download packages from a network mirror."""
    if any(marker in line for line in lines for marker in DNF_MISSING):
        return False
    if any(line.startswith('Error: ') and line != 'Error: Error downloading packages:'
           for line in lines):
        return False
    if not any(any(marker in line for marker in DNF_NETWORK)
               and ('http://' in line or 'https://' in line) for line in lines):
        return False
    return any(line == 'Error: Error downloading packages:'
               or line == 'Failed to download packages' for line in lines)


def pacman_download_failure(lines):
    """True when pacman failed to retrieve package files from a mirror, with no missing package."""
    def failed(line):
        return line.startswith('error: failed retrieving file ') or line == PACMAN_COMMIT

    def network(line):
        _, separator, reason = line.partition(' : ')
        return bool(separator) and any(marker in reason for marker in PACMAN_NETWORK)

    errors = [line for line in lines if line.startswith('error: ')]
    if not errors or not all(failed(line) for line in errors):
        return False
    fetches = [line for line in lines if line.startswith('error: failed retrieving file ')]
    return bool(fetches) and all(network(line) for line in fetches)


def zypper_download_failure(lines):
    """True when zypper failed to provide a package it could not download from a mirror."""
    if any('No provider of' in line or 'not found in package names' in line for line in lines):
        return False
    if not any(marker in line for line in lines for marker in ZYPPER_NETWORK):
        return False
    return any(line.startswith('Failed to provide Package ')
               and 'Do you want to retry retrieval?' in line for line in lines)


DOWNLOAD_FAILURES = {'apt-get': apt_download_failure, 'dnf': dnf_download_failure,
                     'pacman': pacman_download_failure, 'zypper': zypper_download_failure}


def plain_lines(lines, start, stop):
    """Return the text of the non-mkosi lines between two log line indexes."""
    texts = []
    for line in lines[start + 1:stop]:
        text = cleaned(line)
        if not text.startswith('‣'):
            texts.append(text)
    return texts


def classify(lines):
    """Return 'sync', 'download' or None for the failure that ended this run."""
    messages = [(index, text) for index, text
                in ((index, message(line)) for index, line in enumerate(lines))
                if text is not None]
    if len(messages) < 2:
        return None
    tail = messages[-3:] if messages[-1][1].startswith(SANDBOX_LINE) else messages[-2:]
    if len(tail) < 2:
        return None
    (step_index, step), (failure_index, failure_text) = tail[0], tail[1]
    failure = FAILED.match(failure_text)
    if not failure:
        return None
    command = failure.group(1)
    if step == SYNC_STEP and is_sync_command(command):
        return 'sync'
    if not is_install_step(step):
        return None
    tool = install_tool(command)
    if tool is None:
        return None
    between = plain_lines(lines, step_index, failure_index)
    if any(marker in line for line in between for marker in LOCAL_FAILURES):
        return None
    return 'download' if DOWNLOAD_FAILURES[tool](between) else None


def setting(name, default, minimum):
    raw = os.environ.get(name)
    if raw is None:
        return default
    if not re.fullmatch(r'[0-9]+', raw) or int(raw) < minimum:
        kind = 'a positive integer' if minimum else 'a non-negative integer'
        print(f'{name} must be {kind}.', file=sys.stderr)
        sys.exit(2)
    return int(raw)


def run(command):
    """Stream the command's output unchanged; keep its lines and note a traceback."""
    env = dict(os.environ, PYTHONUNBUFFERED='1')
    lines = []
    traceback = False
    out = sys.stdout.buffer
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env) as child:
        for raw in child.stdout:
            out.write(raw)
            out.flush()
            line = raw.decode('utf-8', 'replace')
            if cleaned(line) == TRACEBACK:
                traceback = True
            lines.append(line)
    return child.returncode, lines, traceback


def main(argv):
    if not argv:
        print('Usage: builder-mkosi-retry COMMAND [ARGS...]', file=sys.stderr)
        return 2
    tries = setting('NSL_MKOSI_TRIES', 3, 1)
    delay = setting('NSL_MKOSI_RETRY_DELAY', 60, 0)
    code = 0
    for attempt in range(1, tries + 1):
        try:
            code, lines, traceback = run(argv)
        except OSError as error:
            print(f'Cannot run {argv[0]}: {error}', file=sys.stderr)
            return 127
        if code < 0:
            # Report a child killed by a signal as a shell does.
            return 128 - code
        kind = None if code == 0 or traceback else classify(lines)
        if kind is None:
            return code
        if attempt == tries:
            print(f'{MESSAGES[kind]} after {tries} tries.', file=sys.stderr)
            return code
        wait = delay * 3 ** (attempt - 1)
        print(f'{MESSAGES[kind]} (try {attempt} of {tries}); retrying in {wait} s.',
              file=sys.stderr, flush=True)
        time.sleep(wait)
    return code


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
