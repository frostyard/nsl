#!/usr/bin/python3
"""Regenerate installed kernels before removing obsolete nsl-managed UKIs."""
import json
from pathlib import Path
import re
import subprocess
import sys


def synchronize(root=Path('/'), run=subprocess.run, initialize=False):
    kernels = sorted((root/'usr/lib/modules').glob('*/vmlinuz'))
    versions = [p.parent.name for p in kernels]
    record = root/'var/lib/nsl/arch-kernels.json'
    previous = json.loads(record.read_text()) if record.exists() else []
    if not isinstance(previous, list) or any(
            not isinstance(v, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._+-]*', v)
            for v in previous + versions):
        raise ValueError('invalid managed kernel inventory')
    if initialize and record.exists():
        return
    if not initialize:
        if not kernels:
            raise ValueError('refusing to remove the last bootable kernel')
        # Preserve old boot entries if any new image fails to build.
        for kernel, version in zip(kernels, versions):
            run(['kernel-install', 'add', version, str(kernel)], check=True)
        for version in sorted(set(previous) - set(versions)):
            run(['kernel-install', 'remove', version], check=True)
    record.parent.mkdir(parents=True, exist_ok=True)
    temporary = record.with_suffix('.tmp')
    temporary.write_text(json.dumps(versions) + '\n')
    temporary.replace(record)


if __name__ == '__main__':
    if sys.argv[1:] not in ([], ['--initialize']):
        raise SystemExit('usage: nsl-kernel-sync [--initialize]')
    synchronize(initialize=bool(sys.argv[1:]))
