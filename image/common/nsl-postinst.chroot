#!/bin/sh
set -eu
chmod 0755 /usr/local/libexec/nsl-exec /usr/local/libexec/nsl-setup /usr/local/libexec/nsl-platform-setup
systemctl enable systemd-networkd systemd-resolved nsl-setup.service nsl-ssh.socket
# nsl uses the vsock listener; distro SSH units remain available for guest admins.
systemctl disable ssh.service ssh.socket sshd.service sshd.socket 2>/dev/null || true
rm -f /etc/ssh/ssh_host_*
mkdir -p /usr/lib/nsl
printf '1\n' > /usr/lib/nsl/image-version
