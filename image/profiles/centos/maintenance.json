{
  "refresh": [
    "dnf",
    "makecache"
  ],
  "install_containers": [
    "dnf",
    "install",
    "-y",
    "podman",
    "slirp4netns",
    "fuse-overlayfs"
  ],
  "kernel_policy": [
    "dnf",
    "list",
    "--installed",
    "kernel-core"
  ],
  "kernel_reinstall": [
    "dnf",
    "reinstall",
    "-y",
    "kernel-core-{kernel}"
  ],
  "audit": [
    "dnf",
    "check"
  ],
  "uki_glob": "/efi/EFI/Linux/*.efi",
  "audit_empty": false
}
