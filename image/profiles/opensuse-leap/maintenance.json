{
  "refresh": [
    "zypper",
    "--non-interactive",
    "refresh"
  ],
  "install_containers": [
    "zypper",
    "--non-interactive",
    "install",
    "podman",
    "shadow",
    "slirp4netns",
    "fuse-overlayfs"
  ],
  "kernel_policy": [
    "zypper",
    "--non-interactive",
    "search",
    "--installed-only",
    "kernel-default"
  ],
  "kernel_reinstall": [
    "zypper",
    "--non-interactive",
    "install",
    "--force",
    "kernel-default"
  ],
  "audit": [
    "zypper",
    "--non-interactive",
    "verify"
  ],
  "audit_empty": false,
  "uki_glob": "/efi/EFI/Linux/*.efi"
}
