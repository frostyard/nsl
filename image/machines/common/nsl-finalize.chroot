#!/bin/sh
# The machine layer: runs after the recipes' post-install scripts, so it wins.
set -eu
# Machines share the VM's network namespace and bind its resolver: mask both
# services and every networkd and resolved unit installed, sockets included.
for unit in systemd-networkd.service systemd-resolved.service \
    /usr/lib/systemd/system/systemd-networkd* /usr/lib/systemd/system/systemd-resolved*; do
  case $unit in *'*') continue ;; esac
  ln -sf /dev/null "/etc/systemd/system/${unit##*/}"
done
# sshd serves ssh-config per connection; nothing listens.
systemctl disable ssh.service ssh.socket sshd.service sshd.socket 2>/dev/null || true
# Every machine generates its own identity on first boot.
rm -f /etc/ssh/ssh_host_* /var/lib/systemd/random-seed
printf 'uninitialized\n' > /etc/machine-id
. /usr/lib/os-release
systemd=$(systemctl --version | sed -n '1s/^systemd [0-9]* (\([^)]*\)).*/\1/p')
sed -i -e "s|@OS_ID@|$ID|" -e "s|@OS_VERSION@|${VERSION_ID:-${BUILD_ID:-rolling}}|" -e "s|@SYSTEMD@|$systemd|" /usr/lib/nsl/machine.json
